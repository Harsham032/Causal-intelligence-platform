# Copy to .env and adjust. Never commit .env.

# --- Environment ---
CIP_ENV=development
CIP_LOG_LEVEL=INFO

# --- Analytics warehouse ---
# DuckDB is the zero-dependency default: a single file, no server.
CIP_WAREHOUSE_PATH=data/processed/cip.duckdb
# Optional PostgreSQL for shared analytics.
# CIP_POSTGRES_URL=postgresql+psycopg://<user>:<password>@<host>:5432/cip

# --- Data ---
CIP_DATA_DIR=data
# The Criteo uplift dataset is downloaded on request; see docs/data-sources.md.
CIP_CRITEO_URL=https://criteo-bucket.s3.eu-central-1.amazonaws.com/criteo-research-uplift-v2.1.csv.gz

# --- Dashboard ---
CIP_DASHBOARD_PORT=8501
